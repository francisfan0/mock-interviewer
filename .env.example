# Free tier (recommended): https://console.groq.com/keys
GROQ_API_KEY=

# Paid alternatives (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model ids use "provider:model". If unset, the first available key wins
# (Groq → Anthropic → OpenAI). Groq default: groq:openai/gpt-oss-120b
# INTERVIEWER_MODEL=groq:openai/gpt-oss-120b
# INTERVIEWER_MODEL=groq:openai/gpt-oss-20b
# INTERVIEWER_MODEL=anthropic:claude-sonnet-5-5
# GENERATOR_MODEL=groq:openai/gpt-oss-120b
